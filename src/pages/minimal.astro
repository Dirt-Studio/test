---
import { messages } from "../i18n/messages";

const t = messages.zh;

const destinations = [
  {
    nameKey: "destForum",
    blurbKey: "destForumBlurb",
    tagKey: "tagSoon",
    href: "#forum",
    image: "/images/room.jpg",
    altKey: "altRoom",
    span: "feature",
    soon: true
  },
  {
    nameKey: "destTools",
    blurbKey: "destToolsBlurb",
    tagKey: "tagLive",
    href: "https://tools.imc899856.dpdns.org",
    image: "/images/tools.jpg",
    altKey: "altTools",
    span: "wide",
    soon: false
  },
  {
    nameKey: "destBlog",
    blurbKey: "destBlogBlurb",
    tagKey: "tagLive",
    href: "https://blog.imc899856.dpdns.org",
    image: "/images/notes.jpg",
    altKey: "altNotes",
    span: "half",
    soon: false
  },
  {
    nameKey: "destChat",
    blurbKey: "destChatBlurb",
    tagKey: "tagLive",
    href: "https://chat.imc899856.dpdns.org",
    image: "/images/workshop.jpg",
    altKey: "altWorkshop",
    span: "half",
    soon: false
  },
  {
    nameKey: "destGame",
    blurbKey: "destGameBlurb",
    tagKey: "tagLive",
    href: "https://game.imc899856.dpdns.org",
    image: "/images/desk.jpg",
    altKey: "altDesk",
    span: "wide",
    soon: false
  }
] as const;

const tools = [
  { nameKey: "toolStack", metaKey: "toolStackMeta", href: "https://tools.imc899856.dpdns.org/mc-stack" },
  { nameKey: "toolRecipes", metaKey: "toolRecipesMeta", href: "https://tools.imc899856.dpdns.org/mc-recipes" },
  { nameKey: "toolFuel", metaKey: "toolFuelMeta", href: "https://tools.imc899856.dpdns.org/fuel" },
  { nameKey: "toolEnchant", metaKey: "toolEnchantMeta", href: "https://tools.imc899856.dpdns.org/enchant" }
] as const;

const posts = [
  { titleKey: "post1", date: "2026-08-14", href: "https://blog.imc899856.dpdns.org/caddy-tunnel", image: "/images/rack.jpg" },
  { titleKey: "post2", date: "2026-07-02", href: "https://blog.imc899856.dpdns.org/chat-durable-objects", image: "/images/board.jpg" },
  { titleKey: "post3", date: "2026-05-21", href: "https://blog.imc899856.dpdns.org/mc-recipe-datapack", image: "/images/notes.jpg" }
] as const;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDesc} />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>

    <header class="mast">
      <div class="wrap mast__inner">
        <a class="brand" href="/minimal">
          <span class="brand__mark" aria-hidden="true">IM</span>
          <span class="brand__word">imc899856</span>
        </a>
        <nav class="mast__nav" aria-label="Primary">
          <a href="#hub" data-i18n="navHub">{t.navHub}</a>
          <a href="#tools" data-i18n="navTools">{t.navTools}</a>
          <a href="#blog" data-i18n="navBlog">{t.navBlog}</a>
          <a href="#contact" data-i18n="navContact">{t.navContact}</a>
          <div class="lang" role="group" aria-label="Language">
            <button type="button" class="lang__btn" data-lang="zh" data-i18n="langZh" aria-pressed="true">{t.langZh}</button>
            <button type="button" class="lang__btn" data-lang="en" data-i18n="langEn" aria-pressed="false">{t.langEn}</button>
          </div>
          <a class="mast__alt" href="/" data-i18n="navPremium">{t.navPremium}</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero__grid">
          <div class="hero__copy">
            <p class="kicker reveal" data-i18n="kicker">{t.kicker}</p>
            <h1 class="hero__title reveal" style="--index:1">
              <span data-i18n="heroTitle1">{t.heroTitle1}</span><br />
              <span data-i18n="heroTitle2">{t.heroTitle2}</span>
            </h1>
            <p class="hero__body reveal" style="--index:2" data-i18n="heroBody">
              {t.heroBody}
            </p>
            <div class="hero__actions reveal" style="--index:3">
              <a class="btn btn--solid" href="#hub" data-i18n="ctaBrowse">{t.ctaBrowse}</a>
              <a class="btn btn--ghost" href="https://tools.imc899856.dpdns.org" data-i18n="ctaTools">{t.ctaTools}</a>
            </div>
          </div>
          <figure class="hero__frame reveal" style="--index:1">
            <img
              class="hero__photo"
              src="/images/rack.jpg"
              alt={t.altRack}
              data-i18n-alt="altRack"
              width="900"
              height="1200"
            />
            <figcaption class="hero__cap" data-i18n="heroCaption">{t.heroCaption}</figcaption>
          </figure>
        </div>
      </section>

      <section class="section" id="hub">
        <div class="wrap">
          <div class="head reveal">
            <h2 class="head__title" data-i18n="hubTitle">{t.hubTitle}</h2>
            <p class="head__body" data-i18n="hubBody">{t.hubBody}</p>
          </div>

          <div class="bento">
            {destinations.map((p, i) => (
              p.soon ? (
                <div
                  class:list={["cell", "cell--soon", `cell--${p.span}`, "reveal"]}
                  style={`--index:${i}`}
                  id="forum"
                >
                  <div class="cell__media">
                    <img src={p.image} alt={t[p.altKey]} data-i18n-alt={p.altKey} width="1200" height="800" />
                  </div>
                  <div class="cell__body">
                    <div class="cell__top">
                      <span class="tag" data-i18n={p.tagKey}>{t[p.tagKey]}</span>
                    </div>
                    <div class="cell__bottom">
                      <h3 class="cell__name" data-i18n={p.nameKey}>{t[p.nameKey]}</h3>
                      <p class="cell__blurb" data-i18n={p.blurbKey}>{t[p.blurbKey]}</p>
                    </div>
                  </div>
                </div>
              ) : (
                <a
                  class:list={["cell", `cell--${p.span}`, "reveal"]}
                  style={`--index:${i}`}
                  href={p.href}
                >
                  <div class="cell__media">
                    <img src={p.image} alt={t[p.altKey]} data-i18n-alt={p.altKey} width="1200" height="800" />
                  </div>
                  <div class="cell__body">
                    <div class="cell__top">
                      <span class="tag" data-i18n={p.tagKey}>{t[p.tagKey]}</span>
                      <span class="cell__go" aria-hidden="true">
                        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6">
                          <path d="M5 11 11 5M6.5 5H11v4.5" />
                        </svg>
                      </span>
                    </div>
                    <div class="cell__bottom">
                      <h3 class="cell__name" data-i18n={p.nameKey}>{t[p.nameKey]}</h3>
                      <p class="cell__blurb" data-i18n={p.blurbKey}>{t[p.blurbKey]}</p>
                    </div>
                  </div>
                </a>
              )
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="tools">
        <div class="wrap">
          <div class="head reveal">
            <h2 class="head__title" data-i18n="toolsTitle">{t.toolsTitle}</h2>
            <p class="head__body" data-i18n="toolsBody">{t.toolsBody}</p>
          </div>

          <ul class="rows">
            {tools.map((tool, i) => (
              <li class="reveal" style={`--index:${i}`}>
                <a class="row" href={tool.href}>
                  <span class="row__name" data-i18n={tool.nameKey}>{t[tool.nameKey]}</span>
                  <kbd class="row__meta" data-i18n={tool.metaKey}>{t[tool.metaKey]}</kbd>
                  <span class="row__arrow" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="blog">
        <div class="wrap">
          <div class="head reveal">
            <h2 class="head__title" data-i18n="blogTitle">{t.blogTitle}</h2>
            <p class="head__body" data-i18n="blogBody">{t.blogBody}</p>
          </div>

          <div class="cards">
            {posts.map((post, i) => (
              <a class="card reveal" style={`--index:${i}`} href={post.href}>
                <div class="card__media">
                  <img src={post.image} alt="" width="800" height="500" />
                </div>
                <time class="card__date" datetime={post.date}>{post.date}</time>
                <h3 class="card__title" data-i18n={post.titleKey}>{t[post.titleKey]}</h3>
                <span class="card__more" data-i18n="readArrow">{t.readArrow}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="foot" id="contact">
      <div class="wrap">
        <hr class="rule" />
        <div class="foot__grid">
          <div>
            <h2 class="foot__heading" data-i18n="contactTitle">{t.contactTitle}</h2>
            <p class="foot__body" data-i18n="contactBody">{t.contactBody}</p>
          </div>
          <div class="foot__links">
            <a class="foot__link" href="mailto:hi@imc899856.dpdns.org">hi@imc899856.dpdns.org</a>
            <a class="foot__link" href="https://github.com/" rel="me noopener">GitHub</a>
            <a class="foot__link" href="/" data-i18n="footerAltPremium">{t.footerAltPremium}</a>
          </div>
        </div>
        <p class="foot__meta">© {year} imc899856 · <span data-i18n="footerMeta">{t.footerMeta}</span></p>
      </div>
    </footer>

    <script>
      const targets = document.querySelectorAll(".reveal");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduce) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    <script define:vars={{ messages }}>
      window.__I18N__ = messages;
    </script>
    <script src="/i18n.js" defer></script>

    <style>
      @font-face {
        font-family: "Geist Sans";
        src: url("/fonts/Geist-Variable.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Geist Mono";
        src: url("/fonts/GeistMono-Variable.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --canvas: #f7f6f3;
        --surface: #ffffff;
        --sunken: #fbfbfa;
        --border: #eaeaea;
        --text: #2f3437;
        --strong: #111111;
        --muted: #787774;
        --blue: #1f6c9f;
        --blue-bg: #e1f3fe;
        --green: #346538;
        --green-bg: #edf3ec;
        --yellow: #956400;
        --yellow-bg: #fbf3db;
        --red: #9f2f2d;
        --red-bg: #fdebec;
        --serif: "Newsreader", Georgia, "Songti SC", serif;
        --sans: "Geist Sans", "Helvetica Neue", -apple-system, BlinkMacSystemFont, sans-serif;
        --mono: "Geist Mono", "SF Mono", "JetBrains Mono", monospace;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --gutter: clamp(1.25rem, 4vw, 3rem);
        --content: 1080px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--text);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      h1,
      h2,
      h3 {
        color: var(--strong);
        margin: 0;
        line-height: 1.1;
      }

      p {
        margin: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      ::selection {
        background: var(--blue-bg);
        color: var(--blue);
      }

      :focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 2px;
        border-radius: 4px;
      }

      .wrap {
        width: 100%;
        max-width: var(--content);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .ambient {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
          radial-gradient(ellipse 55% 38% at 12% 8%, rgba(251, 243, 219, 0.45), transparent 58%),
          radial-gradient(ellipse 48% 32% at 88% 72%, rgba(237, 243, 236, 0.4), transparent 55%);
      }

      .ambient::after {
        content: "";
        position: absolute;
        inset: 0;
        opacity: 0.035;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }

      .mast {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(247, 246, 243, 0.82);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .mast__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 64px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        position: relative;
        z-index: 1;
      }

      .brand__mark {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface);
        font-family: var(--mono);
        font-size: 0.6875rem;
        color: var(--strong);
      }

      .brand__word {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--strong);
      }

      .mast__nav {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 3vw, 1.75rem);
        position: relative;
        z-index: 1;
      }

      .mast__nav a {
        font-size: 0.875rem;
        color: var(--muted);
        transition: color 200ms var(--ease);
      }

      .mast__nav a:hover {
        color: var(--strong);
      }

      .lang {
        display: inline-flex;
        align-items: center;
        gap: 0;
        border: 1px solid #eaeaea;
        border-radius: 6px;
        background: var(--surface);
        overflow: hidden;
      }

      .lang__btn {
        appearance: none;
        border: 0;
        background: transparent;
        margin: 0;
        padding: 0.3rem 0.55rem;
        font-family: var(--sans);
        font-size: 0.75rem;
        color: var(--muted);
        cursor: pointer;
        transition:
          color 200ms var(--ease),
          background 200ms var(--ease);
      }

      .lang__btn + .lang__btn {
        border-left: 1px solid #eaeaea;
      }

      .lang__btn:hover {
        color: var(--strong);
      }

      .lang__btn.is-active {
        background: var(--sunken);
        color: var(--strong);
      }

      .mast__alt {
        padding: 0.3rem 0.65rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--strong) !important;
        font-size: 0.8125rem !important;
      }

      .mast__alt:hover {
        background: var(--sunken);
      }

      .hero {
        position: relative;
        z-index: 1;
        padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3rem, 7vw, 5rem);
      }

      .hero__grid {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: clamp(1.75rem, 5vw, 4rem);
        align-items: end;
      }

      .hero__frame {
        order: 0;
      }

      .hero__copy {
        order: 1;
      }

      .hero__copy {
        max-width: 36rem;
        padding-bottom: 0.5rem;
      }

      .hero__frame {
        margin: 0;
        position: relative;
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        background: var(--sunken);
        aspect-ratio: 4 / 5;
      }

      .hero__photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(1) contrast(1.05) brightness(0.92);
        transform: scale(1.02);
      }

      .hero__frame::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 45%, rgba(247, 246, 243, 0.18) 100%),
          rgba(180, 140, 80, 0.08);
        pointer-events: none;
      }

      .hero__cap {
        position: absolute;
        left: 1rem;
        bottom: 1rem;
        z-index: 1;
        font-family: var(--mono);
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #f7f6f3;
      }

      .kicker {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 1.5rem;
      }

      .hero__title {
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(2.4rem, 6vw, 4.2rem);
        letter-spacing: -0.02em;
        line-height: 1.12;
      }

      .hero__body {
        margin-top: 1.5rem;
        max-width: 56ch;
        font-size: 1.0625rem;
        color: var(--muted);
      }

      .hero__actions {
        margin-top: 2.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
        border-radius: 6px;
        padding: 0.625rem 1.125rem;
        font-size: 0.9375rem;
        font-weight: 500;
        border: 1px solid transparent;
        cursor: pointer;
        transition:
          background 200ms var(--ease),
          color 200ms var(--ease),
          border-color 200ms var(--ease),
          transform 200ms var(--ease);
      }

      .btn:active {
        transform: scale(0.98);
      }

      .btn--solid {
        background: var(--strong);
        color: #ffffff;
      }

      .btn--solid:hover {
        background: #333333;
      }

      .btn--ghost {
        background: transparent;
        color: var(--strong);
        border-color: var(--border);
      }

      .btn--ghost:hover {
        background: var(--surface);
        border-color: #dcdcdc;
      }

      .section {
        position: relative;
        z-index: 1;
        padding-block: clamp(2.5rem, 6vw, 4.5rem);
      }

      .head {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 2.25rem;
      }

      .head__title {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 1.75rem;
        letter-spacing: -0.01em;
      }

      .head__body {
        color: var(--muted);
        max-width: 52ch;
      }

      .bento {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
      }

      .cell {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        min-height: 0;
        transition: box-shadow 200ms var(--ease);
      }

      .cell:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .cell--feature {
        grid-column: span 4;
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
      }

      .cell--wide {
        grid-column: span 2;
      }

      .cell--half {
        grid-column: span 2;
      }

      .cell--soon {
        border-style: dashed;
        cursor: default;
        background: var(--sunken);
      }

      .cell--soon:hover {
        box-shadow: none;
      }

      .cell__media {
        position: relative;
        overflow: hidden;
        min-height: 160px;
        background: var(--sunken);
      }

      .cell--feature .cell__media {
        min-height: 280px;
      }

      .cell__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: grayscale(1) contrast(1.04) brightness(0.96);
        transition: transform 600ms var(--ease), filter 600ms var(--ease);
      }

      .cell__media::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(180, 140, 80, 0.08);
        pointer-events: none;
      }

      .cell:hover .cell__media img {
        transform: scale(1.03);
        filter: grayscale(0.55) contrast(1.04) brightness(0.98);
      }

      .cell--soon:hover .cell__media img {
        transform: none;
        filter: grayscale(1) contrast(1.04) brightness(0.96);
      }

      .cell__body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.75rem;
        padding: 1.35rem 1.5rem 1.5rem;
      }

      .cell__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .cell__go {
        color: var(--muted);
        display: inline-flex;
        transition: color 200ms var(--ease), transform 200ms var(--ease);
      }

      .cell:hover .cell__go {
        color: var(--strong);
        transform: translate(2px, -2px);
      }

      .cell__name {
        font-size: 1.25rem;
        letter-spacing: -0.02em;
        font-weight: 560;
      }

      .cell__blurb {
        margin-top: 0.5rem;
        color: var(--muted);
        font-size: 0.9375rem;
        max-width: 42ch;
      }

      .tag {
        display: inline-flex;
        align-items: center;
        border-radius: 4px;
        padding: 0.1875rem 0.45rem;
        font-family: var(--mono);
        font-size: 0.6875rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: var(--sunken);
        color: var(--muted);
        border: 1px solid var(--border);
      }

      .rows {
        border-top: 1px solid var(--border);
      }

      .row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-block: 1.125rem;
        border-bottom: 1px solid var(--border);
        transition: background 200ms var(--ease);
      }

      .row:hover {
        background: var(--surface);
      }

      .row__name {
        font-weight: 500;
        color: var(--strong);
      }

      .row__meta {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 0.6875rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: var(--sunken);
        padding: 0.15rem 0.4rem;
        color: var(--muted);
      }

      .row__arrow {
        color: var(--muted);
        display: inline-flex;
        transition: transform 200ms var(--ease), color 200ms var(--ease);
      }

      .row:hover .row__arrow {
        transform: translateX(3px);
        color: var(--strong);
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 0 0 1.25rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface);
        overflow: hidden;
        transition: box-shadow 200ms var(--ease);
      }

      .card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .card__media {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: var(--sunken);
      }

      .card__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(1) contrast(1.04) brightness(0.95);
        transition: transform 600ms var(--ease), filter 600ms var(--ease);
      }

      .card__media::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(180, 140, 80, 0.08);
        pointer-events: none;
      }

      .card:hover .card__media img {
        transform: scale(1.03);
        filter: grayscale(0.5) contrast(1.04) brightness(0.98);
      }

      .card__date,
      .card__title,
      .card__more {
        padding-inline: 1.25rem;
      }

      .card__date {
        margin-top: 1rem;
      }

      .card__date {
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
      }

      .card__title {
        font-size: 1.0625rem;
        letter-spacing: -0.015em;
        line-height: 1.35;
        font-weight: 560;
      }

      .card__more {
        margin-top: auto;
        font-size: 0.875rem;
        color: var(--muted);
      }

      .foot {
        position: relative;
        z-index: 1;
        margin-top: clamp(5rem, 12vw, 9rem);
        padding-bottom: 3rem;
      }

      .rule {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 0;
      }

      .foot__grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 2rem;
        padding-top: 2.5rem;
      }

      .foot__heading {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
      }

      .foot__body {
        color: var(--muted);
        max-width: 42ch;
      }

      .foot__links {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .foot__link {
        font-size: 0.9375rem;
        color: var(--strong);
        border-bottom: 1px solid var(--border);
        padding-bottom: 1px;
        transition: border-color 200ms var(--ease);
      }

      .foot__link:hover {
        border-color: var(--strong);
      }

      .foot__meta {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
      }

      .reveal {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 600ms var(--ease), transform 600ms var(--ease);
        transition-delay: calc(var(--index, 0) * 80ms);
      }

      .reveal.is-visible {
        opacity: 1;
        transform: none;
      }

      @media (max-width: 1023px) {
        .hero__grid {
          grid-template-columns: 1fr;
          align-items: start;
        }
        .hero__copy {
          order: 0;
        }
        .hero__frame {
          order: 1;
          aspect-ratio: 16 / 10;
          max-width: 36rem;
        }
        .bento {
          grid-template-columns: repeat(2, 1fr);
        }
        .cell--feature {
          grid-column: span 2;
          grid-template-columns: 1fr;
        }
        .cards {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 767px) {
        .bento {
          grid-template-columns: 1fr;
        }
        .cell--wide,
        .cell--half,
        .cell--feature {
          grid-column: span 1;
          grid-template-columns: 1fr;
        }
        .cell {
          min-height: 0;
        }
        .hero__frame {
          aspect-ratio: 4 / 3;
        }
        .foot__grid {
          grid-template-columns: 1fr;
          gap: 1.75rem;
        }
        .mast__nav a:not(.mast__alt) {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </body>
</html>
