---
const projects = [
  {
    name: "MC 物品数量转换",
    href: "https://tools.imc899856.dpdns.org/mc-stack",
    blurb: "在堆、组、个之间换算，直接给出箱子占用与剩余格数。",
    tag: "工具",
    tint: "blue",
    span: "wide"
  },
  {
    name: "合成配方查询",
    href: "https://tools.imc899856.dpdns.org/mc-recipes",
    blurb: "按产物反查所需材料，支持多级展开到基础资源。",
    tag: "工具",
    tint: "green",
    span: "wide"
  },
  {
    name: "聊天室",
    href: "https://chat.imc899856.dpdns.org",
    blurb: "自托管 WebSocket 房间，无账号，进来就能说话。",
    tag: "服务",
    tint: "yellow",
    span: "half"
  },
  {
    name: "网页游戏",
    href: "https://game.imc899856.dpdns.org",
    blurb: "几款跑在浏览器里的小游戏，零安装。",
    tag: "实验",
    tint: "red",
    span: "half"
  }
];

const tools = [
  { name: "堆叠换算", href: "https://tools.imc899856.dpdns.org/mc-stack", meta: "64 / 组" },
  { name: "配方查询", href: "https://tools.imc899856.dpdns.org/mc-recipes", meta: "3 级展开" },
  { name: "燃料对照", href: "https://tools.imc899856.dpdns.org/fuel", meta: "14 种" },
  { name: "附魔成本", href: "https://tools.imc899856.dpdns.org/enchant", meta: "等级表" }
];

const posts = [
  { title: "把内网穿透换成 Caddy 之后", date: "2026-08-14", href: "https://blog.imc899856.dpdns.org/caddy-tunnel" },
  { title: "自建聊天室为什么选了 Durable Objects", date: "2026-07-02", href: "https://blog.imc899856.dpdns.org/chat-durable-objects" },
  { title: "MC 配方数据怎么从本地 jar 里抠出来", date: "2026-05-21", href: "https://blog.imc899856.dpdns.org/mc-recipe-datapack" }
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>imc899856 · Minimal</title>
    <meta name="description" content="自建工具、博客与联网小玩意的入口。" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="ambient" aria-hidden="true"></div>

    <header class="mast">
      <div class="wrap mast__inner">
        <a class="brand" href="/minimal">
          <span class="brand__mark" aria-hidden="true">IM</span>
          <span class="brand__word">imc899856</span>
        </a>
        <nav class="mast__nav" aria-label="Primary">
          <a href="#work">项目</a>
          <a href="#tools">工具</a>
          <a href="#writing">写作</a>
          <a href="#contact">联系</a>
          <a class="mast__alt" href="/">高端版</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero__inner">
          <p class="kicker reveal">自建站 / 工具与写作</p>
          <h1 class="hero__title reveal" style="--index:1">
            我把自己用得到的<br />东西都搬到了这台服务器上。
          </h1>
          <p class="hero__body reveal" style="--index:2">
            一堆 Minecraft 小工具、一个没有账号的聊天室，还有记下来的技术笔记。全部自托管，没有广告，也没有注册墙。
          </p>
          <div class="hero__actions reveal" style="--index:3">
            <a class="btn btn--solid" href="#work">看看做了什么</a>
            <a class="btn btn--ghost" href="https://blog.imc899856.dpdns.org">读博客</a>
          </div>
        </div>
      </section>

      <section class="section" id="work">
        <div class="wrap">
          <div class="head reveal">
            <h2 class="head__title">项目</h2>
            <p class="head__body">四样东西，每样都是自己先用得上才做的。</p>
          </div>

          <div class="bento">
            {projects.map((p, i) => (
              <a
                class:list={["cell", `cell--${p.span}`, "reveal"]}
                style={`--index:${i}`}
                href={p.href}
              >
                <div class="cell__top">
                  <span class:list={["tag", `tag--${p.tint}`]}>{p.tag}</span>
                  <span class="cell__go" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="M5 11 11 5M6.5 5H11v4.5" />
                    </svg>
                  </span>
                </div>
                <div class="cell__bottom">
                  <h3 class="cell__name">{p.name}</h3>
                  <p class="cell__blurb">{p.blurb}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="tools">
        <div class="wrap">
          <div class="head reveal">
            <h2 class="head__title">常用工具</h2>
            <p class="head__body">放在工具站里的快捷入口，点开就能用。</p>
          </div>

          <ul class="rows">
            {tools.map((t, i) => (
              <li class="reveal" style={`--index:${i}`}>
                <a class="row" href={t.href}>
                  <span class="row__name">{t.name}</span>
                  <kbd class="row__meta">{t.meta}</kbd>
                  <span class="row__arrow" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="writing">
        <div class="wrap">
          <div class="head reveal">
            <h2 class="head__title">最近写的</h2>
            <p class="head__body">踩过的坑、做过的取舍，都记在博客里。</p>
          </div>

          <div class="cards">
            {posts.map((post, i) => (
              <a class="card reveal" style={`--index:${i}`} href={post.href}>
                <time class="card__date" datetime={post.date}>{post.date}</time>
                <h3 class="card__title">{post.title}</h3>
                <span class="card__more">阅读 →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="foot" id="contact">
      <div class="wrap">
        <hr class="rule" />
        <div class="foot__grid">
          <div>
            <h2 class="foot__heading">联系</h2>
            <p class="foot__body">想聊工具、网站或者随便聊聊，直接发信即可。</p>
          </div>
          <div class="foot__links">
            <a class="foot__link" href="mailto:hi@imc899856.dpdns.org">hi@imc899856.dpdns.org</a>
            <a class="foot__link" href="https://github.com/" rel="me noopener">GitHub</a>
            <a class="foot__link" href="/">看高端版</a>
          </div>
        </div>
        <p class="foot__meta">© {year} imc899856 · Minimalist UI</p>
      </div>
    </footer>

    <script>
      const targets = document.querySelectorAll(".reveal");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduce) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    <style>
      @font-face {
        font-family: "Geist Sans";
        src: url("/fonts/Geist-Variable.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Geist Mono";
        src: url("/fonts/GeistMono-Variable.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --canvas: #f7f6f3;
        --surface: #ffffff;
        --sunken: #fbfbfa;
        --border: #eaeaea;
        --text: #2f3437;
        --strong: #111111;
        --muted: #787774;
        --blue: #1f6c9f;
        --blue-bg: #e1f3fe;
        --green: #346538;
        --green-bg: #edf3ec;
        --yellow: #956400;
        --yellow-bg: #fbf3db;
        --red: #9f2f2d;
        --red-bg: #fdebec;
        --serif: "Newsreader", Georgia, "Songti SC", serif;
        --sans: "Geist Sans", "Helvetica Neue", -apple-system, BlinkMacSystemFont, sans-serif;
        --mono: "Geist Mono", "SF Mono", "JetBrains Mono", monospace;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --gutter: clamp(1.25rem, 4vw, 3rem);
        --content: 1080px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--text);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      h1,
      h2,
      h3 {
        color: var(--strong);
        margin: 0;
        line-height: 1.1;
      }

      p {
        margin: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      ::selection {
        background: var(--blue-bg);
        color: var(--blue);
      }

      :focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 2px;
        border-radius: 4px;
      }

      .wrap {
        width: 100%;
        max-width: var(--content);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .ambient {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
          radial-gradient(ellipse 60% 40% at 15% 10%, rgba(225, 243, 254, 0.55), transparent 60%),
          radial-gradient(ellipse 50% 35% at 85% 70%, rgba(237, 243, 236, 0.5), transparent 55%);
        opacity: 0.9;
      }

      .mast {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(247, 246, 243, 0.82);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .mast__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 64px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.625rem;
        position: relative;
        z-index: 1;
      }

      .brand__mark {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface);
        font-family: var(--mono);
        font-size: 0.6875rem;
        color: var(--strong);
      }

      .brand__word {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--strong);
      }

      .mast__nav {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 3vw, 1.75rem);
        position: relative;
        z-index: 1;
      }

      .mast__nav a {
        font-size: 0.875rem;
        color: var(--muted);
        transition: color 200ms var(--ease);
      }

      .mast__nav a:hover {
        color: var(--strong);
      }

      .mast__alt {
        padding: 0.3rem 0.65rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--strong) !important;
        font-size: 0.8125rem !important;
      }

      .mast__alt:hover {
        background: var(--sunken);
      }

      .hero {
        position: relative;
        z-index: 1;
        padding-block: clamp(4rem, 9vw, 6.5rem) clamp(3rem, 7vw, 5rem);
      }

      .hero__inner {
        max-width: 780px;
      }

      .kicker {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 1.5rem;
      }

      .hero__title {
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(2.4rem, 6vw, 4.2rem);
        letter-spacing: -0.02em;
        line-height: 1.12;
      }

      .hero__body {
        margin-top: 1.5rem;
        max-width: 56ch;
        font-size: 1.0625rem;
        color: var(--muted);
      }

      .hero__actions {
        margin-top: 2.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
        border-radius: 6px;
        padding: 0.625rem 1.125rem;
        font-size: 0.9375rem;
        font-weight: 500;
        border: 1px solid transparent;
        cursor: pointer;
        transition:
          background 200ms var(--ease),
          color 200ms var(--ease),
          border-color 200ms var(--ease),
          transform 200ms var(--ease);
      }

      .btn:active {
        transform: scale(0.98);
      }

      .btn--solid {
        background: var(--strong);
        color: #ffffff;
      }

      .btn--solid:hover {
        background: #333333;
      }

      .btn--ghost {
        background: transparent;
        color: var(--strong);
        border-color: var(--border);
      }

      .btn--ghost:hover {
        background: var(--surface);
        border-color: #dcdcdc;
      }

      .section {
        position: relative;
        z-index: 1;
        padding-block: clamp(2.5rem, 6vw, 4.5rem);
      }

      .head {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 2.25rem;
      }

      .head__title {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 1.75rem;
        letter-spacing: -0.01em;
      }

      .head__body {
        color: var(--muted);
        max-width: 52ch;
      }

      .bento {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
      }

      .cell {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2.5rem;
        padding: 1.75rem;
        min-height: 190px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        transition: box-shadow 200ms var(--ease);
      }

      .cell:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .cell--wide {
        grid-column: span 2;
      }

      .cell--half {
        grid-column: span 2;
        background: var(--sunken);
      }

      .cell__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .cell__go {
        color: var(--muted);
        display: inline-flex;
        transition: color 200ms var(--ease), transform 200ms var(--ease);
      }

      .cell:hover .cell__go {
        color: var(--strong);
        transform: translate(2px, -2px);
      }

      .cell__name {
        font-size: 1.25rem;
        letter-spacing: -0.02em;
        font-weight: 560;
      }

      .cell__blurb {
        margin-top: 0.5rem;
        color: var(--muted);
        font-size: 0.9375rem;
        max-width: 42ch;
      }

      .tag {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        padding: 0.1875rem 0.5rem;
        font-family: var(--mono);
        font-size: 0.6875rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .tag--blue {
        background: var(--blue-bg);
        color: var(--blue);
      }

      .tag--green {
        background: var(--green-bg);
        color: var(--green);
      }

      .tag--yellow {
        background: var(--yellow-bg);
        color: var(--yellow);
      }

      .tag--red {
        background: var(--red-bg);
        color: var(--red);
      }

      .rows {
        border-top: 1px solid var(--border);
      }

      .row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-block: 1.125rem;
        border-bottom: 1px solid var(--border);
        transition: background 200ms var(--ease);
      }

      .row:hover {
        background: var(--surface);
      }

      .row__name {
        font-weight: 500;
        color: var(--strong);
      }

      .row__meta {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 0.6875rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: var(--sunken);
        padding: 0.15rem 0.4rem;
        color: var(--muted);
      }

      .row__arrow {
        color: var(--muted);
        display: inline-flex;
        transition: transform 200ms var(--ease), color 200ms var(--ease);
      }

      .row:hover .row__arrow {
        transform: translateX(3px);
        color: var(--strong);
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.5rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--sunken);
        transition: box-shadow 200ms var(--ease);
      }

      .card:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .card__date {
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
      }

      .card__title {
        font-size: 1.0625rem;
        letter-spacing: -0.015em;
        line-height: 1.35;
        font-weight: 560;
      }

      .card__more {
        margin-top: auto;
        font-size: 0.875rem;
        color: var(--muted);
      }

      .foot {
        position: relative;
        z-index: 1;
        margin-top: clamp(5rem, 12vw, 9rem);
        padding-bottom: 3rem;
      }

      .rule {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 0;
      }

      .foot__grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 2rem;
        padding-top: 2.5rem;
      }

      .foot__heading {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
      }

      .foot__body {
        color: var(--muted);
        max-width: 42ch;
      }

      .foot__links {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .foot__link {
        font-size: 0.9375rem;
        color: var(--strong);
        border-bottom: 1px solid var(--border);
        padding-bottom: 1px;
        transition: border-color 200ms var(--ease);
      }

      .foot__link:hover {
        border-color: var(--strong);
      }

      .foot__meta {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
      }

      .reveal {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 600ms var(--ease), transform 600ms var(--ease);
        transition-delay: calc(var(--index, 0) * 80ms);
      }

      .reveal.is-visible {
        opacity: 1;
        transform: none;
      }

      @media (max-width: 1023px) {
        .bento {
          grid-template-columns: repeat(2, 1fr);
        }
        .cards {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 767px) {
        .bento {
          grid-template-columns: 1fr;
        }
        .cell--wide,
        .cell--half {
          grid-column: span 1;
        }
        .cell {
          min-height: 0;
          gap: 1.75rem;
        }
        .foot__grid {
          grid-template-columns: 1fr;
          gap: 1.75rem;
        }
        .mast__nav a:not(.mast__alt) {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
        .reveal {
          opacity: 1;
          transform: none;
        }
      }
    </style>
  </body>
</html>
