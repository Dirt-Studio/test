        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: 0.25rem;
      }

      .island__alt {
        display: none;
        font-size: 0.75rem;
        color: var(--muted);
        padding: 0.4rem 0.75rem;
        border-radius: 9999px;
        border: 1px solid var(--hairline);
        transition: color 500ms var(--ease), border-color 500ms var(--ease);
      }

      .island__alt:hover {
        color: var(--strong);
        border-color: var(--hairline-strong);
      }

      .burger {
        position: relative;
        width: 40px;
        height: 40px;
        border-radius: 9999px;
        border: 1px solid var(--hairline);
        background: rgba(255, 255, 255, 0.04);
        cursor: pointer;
        display: none;
        place-items: center;
      }

      .burger__line {
        position: absolute;
        width: 14px;
        height: 1.5px;
        background: var(--strong);
        border-radius: 2px;
        transition: transform 600ms var(--ease), opacity 400ms var(--ease);
      }

      .burger__line:first-child {
        transform: translateY(-3.5px);
      }

      .burger__line:last-child {
        transform: translateY(3.5px);
      }

      .burger.is-open .burger__line:first-child {
        transform: rotate(45deg);
      }

      .burger.is-open .burger__line:last-child {
        transform: rotate(-45deg);
      }

      .overlay {
        position: fixed;
        inset: 0;
        z-index: 35;
        display: grid;
        place-items: center;
        background: rgba(5, 5, 5, 0.82);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
      }

      .overlay[hidden] {
        display: none;
      }

      .overlay__nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
      }

      .overlay__link {
        font-size: clamp(2rem, 8vw, 3.25rem);
        font-weight: 520;
        letter-spacing: -0.04em;
        color: var(--strong);
        opacity: 0;
        transform: translateY(2.5rem);
        animation: rise 700ms var(--ease) forwards;
        animation-delay: calc(100ms + var(--i) * 70ms);
      }

      @keyframes rise {
        to {
          opacity: 1;
          transform: none;
        }
      }

      .hero {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: flex;
        align-items: flex-end;
        padding-top: 7rem;
        padding-bottom: clamp(4rem, 10vw, 7rem);
      }

      .hero__inner {
        max-width: 860px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        padding: 0.35rem 0.75rem;
        font-family: var(--mono);
        font-size: 0.625rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--hairline);
        margin-bottom: 1.75rem;
      }

      .hero__title {
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        font-weight: 540;
      }

      .hero__title em {
        font-style: italic;
        font-weight: 450;
        color: rgba(255, 255, 255, 0.88);
      }

      .hero__body {
        margin-top: 1.5rem;
        max-width: 48ch;
        font-size: 1.0625rem;
        color: var(--muted);
      }

      .hero__actions {
        margin-top: 2.5rem;
