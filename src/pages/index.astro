---
import { messages } from "../i18n/messages";

const t = messages.zh;

const destinations = [
  {
    nameKey: "destForum",
    blurbKey: "destForumBlurb",
    tagKey: "tagSoon",
    href: "#forum",
    image: "/images/room.jpg",
    altKey: "altRoom",
    size: "hero",
    soon: true
  },
  {
    nameKey: "destTools",
    blurbKey: "destToolsBlurb",
    tagKey: "tagLive",
    href: "https://tools.imc899856.dpdns.org",
    image: "/images/tools.jpg",
    altKey: "altTools",
    size: "md",
    soon: false
  },
  {
    nameKey: "destBlog",
    blurbKey: "destBlogBlurb",
    tagKey: "tagLive",
    href: "https://blog.imc899856.dpdns.org",
    image: "/images/notes.jpg",
    altKey: "altNotes",
    size: "md",
    soon: false
  },
  {
    nameKey: "destChat",
    blurbKey: "destChatBlurb",
    tagKey: "tagLive",
    href: "https://chat.imc899856.dpdns.org",
    image: "/images/workshop.jpg",
    altKey: "altWorkshop",
    size: "half",
    soon: false
  },
  {
    nameKey: "destGame",
    blurbKey: "destGameBlurb",
    tagKey: "tagLive",
    href: "https://game.imc899856.dpdns.org",
    image: "/images/desk.jpg",
    altKey: "altDesk",
    size: "half",
    soon: false
  }
] as const;

const tools = [
  { nameKey: "toolStack", metaKey: "toolStackMeta", href: "https://tools.imc899856.dpdns.org/mc-stack" },
  { nameKey: "toolRecipes", metaKey: "toolRecipesMeta", href: "https://tools.imc899856.dpdns.org/mc-recipes" },
  { nameKey: "toolFuel", metaKey: "toolFuelMeta", href: "https://tools.imc899856.dpdns.org/fuel" },
  { nameKey: "toolEnchant", metaKey: "toolEnchantMeta", href: "https://tools.imc899856.dpdns.org/enchant" }
] as const;

const posts = [
  { titleKey: "post1", date: "2026-08-14", href: "https://blog.imc899856.dpdns.org/caddy-tunnel" },
  { titleKey: "post2", date: "2026-07-02", href: "https://blog.imc899856.dpdns.org/chat-durable-objects" },
  { titleKey: "post3", date: "2026-05-21", href: "https://blog.imc899856.dpdns.org/mc-recipe-datapack" }
] as const;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDesc} />
    <meta name="color-scheme" content="dark" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="orb orb--violet" aria-hidden="true"></div>
    <div class="orb orb--emerald" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <header class="island">
      <a class="island__brand" href="/">
        <span class="island__mark">IM</span>
        <span class="island__word">imc899856</span>
      </a>
      <nav class="island__nav" aria-label="Primary">
        <a href="#hub" data-i18n="navHub">{t.navHub}</a>
        <a href="#tools" data-i18n="navTools">{t.navTools}</a>
        <a href="#blog" data-i18n="navBlog">{t.navBlog}</a>
        <a href="#contact" data-i18n="navContact">{t.navContact}</a>
      </nav>
      <div class="island__actions">
        <div class="lang" role="group" aria-label="Language">
          <button type="button" class="lang__btn" data-lang="zh" data-i18n="langZh" aria-pressed="true">中文</button>
          <button type="button" class="lang__btn" data-lang="en" data-i18n="langEn" aria-pressed="false">EN</button>
        </div>
        <a class="island__alt" href="/minimal" data-i18n="navMinimal">{t.navMinimal}</a>
        <button class="burger" type="button" data-i18n-aria="openMenu" aria-label={t.openMenu} aria-expanded="false" aria-controls="overlay">
          <span class="burger__line"></span>
          <span class="burger__line"></span>
        </button>
      </div>
    </header>

    <div class="overlay" id="overlay" hidden>
      <nav class="overlay__nav" aria-label="Mobile">
        <a class="overlay__link" href="#hub" style="--i:0" data-i18n="navHub">{t.navHub}</a>
        <a class="overlay__link" href="#tools" style="--i:1" data-i18n="navTools">{t.navTools}</a>
        <a class="overlay__link" href="#blog" style="--i:2" data-i18n="navBlog">{t.navBlog}</a>
        <a class="overlay__link" href="#contact" style="--i:3" data-i18n="navContact">{t.navContact}</a>
        <a class="overlay__link" href="/minimal" style="--i:4" data-i18n="navMinimalArrow">{t.navMinimalArrow}</a>
      </nav>
    </div>

    <main>
      <section class="hero">
        <div class="shell hero__inner">
          <span class="eyebrow reveal" data-i18n="eyebrow">{t.eyebrow}</span>
          <h1 class="hero__title reveal" style="--index:1">
            <span data-i18n="heroTitle1">{t.heroTitle1}</span><br />
            <em data-i18n="heroTitle2">{t.heroTitle2}</em>
          </h1>
          <p class="hero__body reveal" style="--index:2" data-i18n="heroBody">
            {t.heroBody}
          </p>
          <div class="hero__actions reveal" style="--index:3">
            <a class="cta" href="#hub">
              <span data-i18n="ctaBrowse">{t.ctaBrowse}</span>
              <span class="cta__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M5 11 11 5M6.5 5H11v4.5" />
                </svg>
              </span>
            </a>
            <a class="ghost" href="https://tools.imc899856.dpdns.org" data-i18n="ctaTools">{t.ctaTools}</a>
          </div>
        </div>
      </section>

      <section class="section" id="hub">
        <div class="shell">
          <div class="section__head reveal">
            <h2 class="section__title" data-i18n="hubTitle">{t.hubTitle}</h2>
            <p class="section__body" data-i18n="hubBody">{t.hubBody}</p>
          </div>

          <div class="bento">
            {destinations.map((p, i) => (
              <div class:list={["bezel", `bezel--${p.size}`, p.soon && "bezel--soon", "reveal"]} style={`--index:${i}`} id={p.soon ? "forum" : undefined}>
                {p.soon ? (
                  <div class="tile tile--soon">
                    <div class="tile__media">
                      <img src={p.image} alt={t[p.altKey]} data-i18n-alt={p.altKey} width="1200" height="800" />
                    </div>
                    <div class="tile__top">
                      <span class="chip chip--soon" data-i18n={p.tagKey}>{t[p.tagKey]}</span>
                    </div>
                    <div class="tile__bottom">
                      <h3 class="tile__name" data-i18n={p.nameKey}>{t[p.nameKey]}</h3>
                      <p class="tile__blurb" data-i18n={p.blurbKey}>{t[p.blurbKey]}</p>
                    </div>
                  </div>
                ) : (
                  <a class="tile" href={p.href}>
                    <div class="tile__media">
                      <img src={p.image} alt={t[p.altKey]} data-i18n-alt={p.altKey} width="1200" height="800" />
                    </div>
                    <div class="tile__top">
                      <span class="chip" data-i18n={p.tagKey}>{t[p.tagKey]}</span>
                      <span class="tile__go" aria-hidden="true">
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4">
                          <path d="M5 11 11 5M6.5 5H11v4.5" />
                        </svg>
                      </span>
                    </div>
                    <div class="tile__bottom">
                      <h3 class="tile__name" data-i18n={p.nameKey}>{t[p.nameKey]}</h3>
                      <p class="tile__blurb" data-i18n={p.blurbKey}>{t[p.blurbKey]}</p>
                    </div>
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="tools">
        <div class="shell">
          <div class="section__head reveal">
            <h2 class="section__title" data-i18n="toolsTitle">{t.toolsTitle}</h2>
            <p class="section__body" data-i18n="toolsBody">{t.toolsBody}</p>
          </div>

          <div class="bezel bezel--full reveal">
            <ul class="tool-list">
              {tools.map((tool, i) => (
                <li style={`--index:${i}`}>
                  <a class="tool" href={tool.href}>
                    <span class="tool__name" data-i18n={tool.nameKey}>{t[tool.nameKey]}</span>
                    <span class="tool__meta" data-i18n={tool.metaKey}>{t[tool.metaKey]}</span>
                    <span class="tool__arrow" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4">
                        <path d="M3 8h10M9 4l4 4-4 4" />
                      </svg>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="section" id="blog">
        <div class="shell">
          <div class="section__head reveal">
            <h2 class="section__title" data-i18n="blogTitle">{t.blogTitle}</h2>
            <p class="section__body" data-i18n="blogBody">{t.blogBody}</p>
          </div>

          <div class="posts">
            {posts.map((post, i) => (
              <div class="bezel reveal" style={`--index:${i}`}>
                <a class="post" href={post.href}>
                  <time class="post__date" datetime={post.date}>{post.date}</time>
                  <h3 class="post__title" data-i18n={post.titleKey}>{t[post.titleKey]}</h3>
                  <span class="post__more">
                    <span data-i18n="read">{t.read}</span>
                    <span class="post__icon" aria-hidden="true">
                      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4">
                        <path d="M3 8h10M9 4l4 4-4 4" />
                      </svg>
                    </span>
                  </span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="foot" id="contact">
      <div class="shell">
        <div class="bezel bezel--full reveal">
          <div class="foot__inner">
            <div>
              <h2 class="foot__heading" data-i18n="contactTitle">{t.contactTitle}</h2>
              <p class="foot__body" data-i18n="contactBody">{t.contactBody}</p>
            </div>
            <div class="foot__links">
              <a href="mailto:hi@imc899856.dpdns.org">hi@imc899856.dpdns.org</a>
              <a href="https://github.com/" rel="me noopener">GitHub</a>
              <a href="/minimal" data-i18n="footerAltMinimal">{t.footerAltMinimal}</a>
            </div>
          </div>
        </div>
        <p class="foot__meta">© {year} imc899856 · <span data-i18n="footerMeta">{t.footerMeta}</span></p>
      </div>
    </footer>

    <script>
      const burger = document.querySelector(".burger");
      const overlay = document.querySelector("#overlay");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      burger?.addEventListener("click", () => {
        const open = burger.getAttribute("aria-expanded") === "true";
        burger.setAttribute("aria-expanded", String(!open));
        burger.classList.toggle("is-open", !open);
        if (overlay) {
          if (open) {
            overlay.hidden = true;
            document.body.classList.remove("menu-open");
          } else {
            overlay.hidden = false;
            document.body.classList.add("menu-open");
          }
        }
      });

      overlay?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          burger?.setAttribute("aria-expanded", "false");
          burger?.classList.remove("is-open");
          if (overlay) overlay.hidden = true;
          document.body.classList.remove("menu-open");
        });
      });

      const targets = document.querySelectorAll(".reveal");
      if (reduce) {
        targets.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    <script define:vars={{ messages }}>
      window.__I18N__ = messages;
    </script>
    <script src="/i18n.js" defer></script>

    <style>
      @font-face {
        font-family: "Geist Sans";
        src: url("/fonts/Geist-Variable.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Geist Mono";
        src: url("/fonts/GeistMono-Variable.woff2") format("woff2");
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg: #050505;
        --surface: #0c0c0c;
        --hairline: rgba(255, 255, 255, 0.08);
        --hairline-strong: rgba(255, 255, 255, 0.14);
        --text: rgba(255, 255, 255, 0.72);
        --strong: #f5f5f5;
        --muted: rgba(255, 255, 255, 0.42);
        --violet: #8b5cf6;
        --emerald: #34d399;
        --sans: "Geist Sans", "Helvetica Neue", -apple-system, BlinkMacSystemFont, sans-serif;
        --mono: "Geist Mono", "SF Mono", ui-monospace, monospace;
        --ease: cubic-bezier(0.32, 0.72, 0, 1);
        --gutter: clamp(1.25rem, 4vw, 3rem);
        --content: 1120px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }

      body.menu-open {
        overflow: hidden;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        color: var(--strong);
        font-weight: 560;
        letter-spacing: -0.04em;
        line-height: 1.08;
      }

      p {
        margin: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      ::selection {
        background: rgba(139, 92, 246, 0.35);
        color: #fff;
      }

      :focus-visible {
        outline: 2px solid rgba(139, 92, 246, 0.7);
        outline-offset: 3px;
        border-radius: 8px;
      }

      .shell {
        width: 100%;
        max-width: var(--content);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      .orb {
        position: fixed;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        z-index: 0;
        opacity: 0.45;
      }

      .orb--violet {
        width: min(52vw, 520px);
        height: min(52vw, 520px);
        top: -12%;
        right: -8%;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.55), transparent 70%);
      }

      .orb--emerald {
        width: min(44vw, 440px);
        height: min(44vw, 440px);
        bottom: 8%;
        left: -10%;
        background: radial-gradient(circle, rgba(52, 211, 153, 0.35), transparent 70%);
      }

      .grain {
        position: fixed;
        inset: 0;
        z-index: 50;
        pointer-events: none;
        opacity: 0.035;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }

      .island {
        position: fixed;
        top: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 40;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        width: max-content;
        max-width: calc(100vw - 2rem);
        padding: 0.4rem 0.4rem 0.4rem 0.85rem;
        border-radius: 9999px;
        background: rgba(12, 12, 12, 0.72);
        border: 1px solid var(--hairline);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
      }

      .island__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
      }

      .island__mark {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--hairline);
        font-family: var(--mono);
        font-size: 0.65rem;
        color: var(--strong);
      }

      .island__word {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        color: var(--strong);
      }

      .island__nav {
        display: flex;
        align-items: center;
        gap: 1.1rem;
      }

      .island__nav a {
        font-size: 0.8125rem;
        color: var(--muted);
        transition: color 500ms var(--ease);
      }

      .island__nav a:hover {
        color: var(--strong);
      }

      .island__actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: 0.25rem;
      }

      .lang {
        display: inline-flex;
        align-items: center;
        gap: 0.15rem;
        padding: 0.15rem;
        border-radius: 9999px;
        border: 1px solid var(--hairline);
        background: rgba(255, 255, 255, 0.03);
      }

      .lang__btn {
        appearance: none;
        border: 0;
        cursor: pointer;
        padding: 0.3rem 0.55rem;
        border-radius: 9999px;
        background: transparent;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.65rem;
        letter-spacing: 0.04em;
        line-height: 1;
        transition: color 500ms var(--ease), background 500ms var(--ease);
      }

      .lang__btn:hover {
        color: var(--strong);
      }

      .lang__btn.is-active,
      .lang__btn[aria-pressed="true"] {
        color: var(--strong);
        background: rgba(255, 255, 255, 0.08);
      }

      .island__alt {
        display: none;
        font-size: 0.75rem;
        color: var(--muted);
        padding: 0.4rem 0.75rem;
        border-radius: 9999px;
        border: 1px solid var(--hairline);
        transition: color 500ms var(--ease), border-color 500ms var(--ease);
      }

      .island__alt:hover {
        color: var(--strong);
        border-color: var(--hairline-strong);
      }

      .burger {
        position: relative;
        width: 40px;
        height: 40px;
        border-radius: 9999px;
        border: 1px solid var(--hairline);
        background: rgba(255, 255, 255, 0.04);
        cursor: pointer;
        display: none;
        place-items: center;
      }

      .burger__line {
        position: absolute;
        width: 14px;
        height: 1.5px;
        background: var(--strong);
        border-radius: 2px;
        transition: transform 600ms var(--ease), opacity 400ms var(--ease);
      }

      .burger__line:first-child {
        transform: translateY(-3.5px);
      }

      .burger__line:last-child {
        transform: translateY(3.5px);
      }

      .burger.is-open .burger__line:first-child {
        transform: rotate(45deg);
      }

      .burger.is-open .burger__line:last-child {
        transform: rotate(-45deg);
      }

      .overlay {
        position: fixed;
        inset: 0;
        z-index: 35;
        display: grid;
        place-items: center;
        background: rgba(5, 5, 5, 0.82);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
      }

      .overlay[hidden] {
        display: none;
      }

      .overlay__nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
      }

      .overlay__link {
        font-size: clamp(2rem, 8vw, 3.25rem);
        font-weight: 520;
        letter-spacing: -0.04em;
        color: var(--strong);
        opacity: 0;
        transform: translateY(2.5rem);
        animation: rise 700ms var(--ease) forwards;
        animation-delay: calc(100ms + var(--i) * 70ms);
      }

      @keyframes rise {
        to {
          opacity: 1;
          transform: none;
        }
      }

      .hero {
        position: relative;
        z-index: 1;
        min-height: 100dvh;
        display: flex;
        align-items: flex-end;
        padding-top: 7rem;
        padding-bottom: clamp(4rem, 10vw, 7rem);
      }

      .hero__inner {
        max-width: 860px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        padding: 0.35rem 0.75rem;
        font-family: var(--mono);
        font-size: 0.625rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--hairline);
        margin-bottom: 1.75rem;
      }

      .hero__title {
        font-size: clamp(2.5rem, 7vw, 4.5rem);
        font-weight: 540;
      }

      .hero__title em {
        font-style: italic;
        font-weight: 450;
        color: rgba(255, 255, 255, 0.88);
      }

      .hero__body {
        margin-top: 1.5rem;
        max-width: 48ch;
        font-size: 1.0625rem;
        color: var(--muted);
      }

      .hero__actions {
        margin-top: 2.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
      }

      .cta {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.55rem 0.55rem 0.55rem 1.35rem;
        border-radius: 9999px;
        background: #f5f5f5;
        color: #0a0a0a;
        font-size: 0.9375rem;
        font-weight: 520;
        transition: transform 500ms var(--ease), background 500ms var(--ease);
      }

      .cta:hover {
        background: #fff;
      }

      .cta:active {
        transform: scale(0.98);
      }

      .cta__icon {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 9999px;
        background: rgba(0, 0, 0, 0.08);
        transition: transform 500ms var(--ease);
      }

      .cta:hover .cta__icon {
        transform: translate(2px, -1px) scale(1.05);
      }

      .ghost {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.35rem;
        border-radius: 9999px;
        border: 1px solid var(--hairline);
        color: var(--strong);
        font-size: 0.9375rem;
        transition: border-color 500ms var(--ease), background 500ms var(--ease), transform 500ms var(--ease);
      }

      .ghost:hover {
        border-color: var(--hairline-strong);
        background: rgba(255, 255, 255, 0.04);
      }

      .ghost:active {
        transform: scale(0.98);
      }

      .section {
        position: relative;
        z-index: 1;
        padding-block: clamp(4rem, 10vw, 7rem);
      }

      .section__head {
        margin-bottom: 2.5rem;
        max-width: 36rem;
      }

      .section__title {
        font-size: clamp(1.75rem, 3.5vw, 2.25rem);
        margin-bottom: 0.65rem;
      }

      .section__body {
        color: var(--muted);
        max-width: 42ch;
      }

      .bezel {
        padding: 0.35rem;
        border-radius: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--hairline);
        transition: border-color 600ms var(--ease), transform 600ms var(--ease);
      }

      .bezel:hover {
        border-color: var(--hairline-strong);
      }

      .tile,
      .post,
      .tool-list {
        border-radius: calc(2rem - 0.35rem);
        background: var(--surface);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08);
      }

      .bento {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1rem;
      }

      .bezel--hero {
        grid-column: span 7;
        grid-row: span 2;
      }

      .bezel--md {
        grid-column: span 5;
      }

      .bezel--wide {
        grid-column: span 12;
      }

      .bezel--half {
        grid-column: span 6;
      }

      .bezel--full {
        grid-column: 1 / -1;
      }

      .bezel--soon {
        border-style: dashed;
        border-color: rgba(255, 255, 255, 0.12);
      }

      .tile {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 200px;
        height: 100%;
        padding: 1.75rem;
        position: relative;
        overflow: hidden;
        transition: background 600ms var(--ease);
      }

      .tile__media {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
      }

      .tile__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.22;
        filter: grayscale(1) contrast(1.15) brightness(0.55);
        transition: opacity 600ms var(--ease), transform 700ms var(--ease);
      }

      .tile:hover .tile__media img {
        opacity: 0.32;
        transform: scale(1.04);
      }

      .tile__top,
      .tile__bottom {
        position: relative;
        z-index: 1;
      }

      .bezel--hero .tile {
        min-height: 340px;
      }

      .tile:hover {
        background: #101010;
      }

      .tile--soon {
        cursor: default;
        background: #0a0a0a;
      }

      .tile--soon:hover {
        background: #0a0a0a;
      }

      .tile__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        padding: 0.3rem 0.7rem;
        font-family: var(--mono);
        font-size: 0.625rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--hairline);
      }

      .chip--soon {
        color: var(--emerald);
        background: rgba(52, 211, 153, 0.08);
        border-color: rgba(52, 211, 153, 0.22);
      }

      .tile__go {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--muted);
        transition: transform 500ms var(--ease), color 500ms var(--ease), background 500ms var(--ease);
      }

      .tile:hover .tile__go {
        color: var(--strong);
        background: rgba(255, 255, 255, 0.1);
        transform: translate(2px, -2px) scale(1.05);
      }

      .tile__name {
        font-size: clamp(1.25rem, 2.4vw, 1.75rem);
      }

      .tile__blurb {
        margin-top: 0.6rem;
        color: var(--muted);
        font-size: 0.9375rem;
        max-width: 42ch;
      }

      .tool-list {
        overflow: hidden;
      }

      .tool {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid var(--hairline);
        transition: background 500ms var(--ease);
      }

      .tool-list li:last-child .tool {
        border-bottom: 0;
      }

      .tool:hover {
        background: rgba(255, 255, 255, 0.03);
      }

      .tool__name {
        font-weight: 500;
        color: var(--strong);
      }

      .tool__meta {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
      }

      .tool__arrow {
        display: inline-flex;
        color: var(--muted);
        transition: transform 500ms var(--ease), color 500ms var(--ease);
      }

      .tool:hover .tool__arrow {
        transform: translateX(4px);
        color: var(--strong);
      }

      .posts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .post {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        padding: 1.6rem;
        min-height: 220px;
        transition: background 600ms var(--ease);
      }

      .post:hover {
        background: #101010;
      }

      .post__date {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        color: var(--muted);
      }

      .post__title {
        font-size: 1.125rem;
        letter-spacing: -0.025em;
        line-height: 1.3;
      }

      .post__more {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.875rem;
        color: var(--muted);
      }

      .post__icon {
        display: inline-flex;
        transition: transform 500ms var(--ease);
      }

      .post:hover .post__icon {
        transform: translateX(3px);
      }

      .foot {
        position: relative;
        z-index: 1;
        padding-block: clamp(3rem, 8vw, 5rem) 3rem;
      }

      .foot__inner {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 2rem;
        padding: 2rem 1.75rem;
        border-radius: calc(2rem - 0.35rem);
        background: var(--surface);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08);
      }

      .foot__heading {
        font-size: 1.5rem;
        margin-bottom: 0.55rem;
      }

      .foot__body {
        color: var(--muted);
        max-width: 40ch;
      }

      .foot__links {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .foot__links a {
        color: var(--strong);
        font-size: 0.9375rem;
        border-bottom: 1px solid var(--hairline);
        padding-bottom: 2px;
        transition: border-color 500ms var(--ease);
      }

      .foot__links a:hover {
        border-color: rgba(255, 255, 255, 0.4);
      }

      .foot__meta {
        margin-top: 1.75rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        color: var(--muted);
      }

      .reveal {
        opacity: 0;
        filter: blur(8px);
        transform: translateY(1.75rem);
        transition:
          opacity 900ms var(--ease),
          transform 900ms var(--ease),
          filter 900ms var(--ease);
        transition-delay: calc(var(--index, 0) * 90ms);
      }

      .reveal.is-visible {
        opacity: 1;
        filter: none;
        transform: none;
      }

      @media (min-width: 900px) {
        .island__alt {
          display: inline-flex;
        }
        .burger {
          display: none;
        }
      }

      @media (max-width: 899px) {
        .island__nav {
          display: none;
        }
        .burger {
          display: grid;
        }
        .bento {
          grid-template-columns: 1fr;
        }
        .bezel--hero,
        .bezel--md,
        .bezel--wide,
        .bezel--half {
          grid-column: span 1;
          grid-row: auto;
        }
        .bezel--hero .tile {
          min-height: 220px;
        }
        .posts {
          grid-template-columns: 1fr;
        }
        .foot__inner {
          grid-template-columns: 1fr;
        }
        .hero {
          align-items: center;
          padding-top: 6rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
        .reveal {
          opacity: 1;
          filter: none;
          transform: none;
        }
        .overlay__link {
          opacity: 1;
          transform: none;
          animation: none;
        }
      }
    </style>
  </body>
</html>
