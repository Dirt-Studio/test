      .tile__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        padding: 0.3rem 0.7rem;
        font-family: var(--mono);
        font-size: 0.625rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--hairline);
      }

      .tile__go {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--muted);
        transition: transform 500ms var(--ease), color 500ms var(--ease), background 500ms var(--ease);
      }

      .tile:hover .tile__go {
        color: var(--strong);
        background: rgba(255, 255, 255, 0.1);
        transform: translate(2px, -2px) scale(1.05);
      }

      .tile__name {
        font-size: clamp(1.25rem, 2.4vw, 1.75rem);
      }

      .tile__blurb {
        margin-top: 0.6rem;
        color: var(--muted);
        font-size: 0.9375rem;
        max-width: 42ch;
      }

      .tool-list {
        overflow: hidden;
      }

      .tool {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.2rem 1.5rem;
        border-bottom: 1px solid var(--hairline);
        transition: background 500ms var(--ease);
      }

      .tool-list li:last-child .tool {
        border-bottom: 0;
      }

      .tool:hover {
        background: rgba(255, 255, 255, 0.03);
      }

      .tool__name {
        font-weight: 500;
        color: var(--strong);
      }

      .tool__meta {
        margin-left: auto;
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--muted);
      }

      .tool__arrow {
        display: inline-flex;
        color: var(--muted);
        transition: transform 500ms var(--ease), color 500ms var(--ease);
      }

      .tool:hover .tool__arrow {
        transform: translateX(4px);
        color: var(--strong);
      }

      .posts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .post {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        padding: 1.6rem;
        min-height: 220px;
        transition: background 600ms var(--ease);
      }

      .post:hover {
        background: #101010;
      }

      .post__date {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        color: var(--muted);
      }

      .post__title {
        font-size: 1.125rem;
        letter-spacing: -0.025em;
        line-height: 1.3;
      }

      .post__more {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.875rem;
        color: var(--muted);
      }

      .post__icon {
        display: inline-flex;
        transition: transform 500ms var(--ease);
      }

      .post:hover .post__icon {
        transform: translateX(3px);
      }

      .foot {
        position: relative;
        z-index: 1;
        padding-block: clamp(3rem, 8vw, 5rem) 3rem;
      }

      .foot__inner {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 2rem;
        padding: 2rem 1.75rem;
        border-radius: calc(2rem - 0.35rem);
        background: var(--surface);
        box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08);
      }

      .foot__heading {
        font-size: 1.5rem;
        margin-bottom: 0.55rem;
      }

      .foot__body {
        color: var(--muted);
        max-width: 40ch;
      }

      .foot__links {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .foot__links a {
        color: var(--strong);
        font-size: 0.9375rem;
        border-bottom: 1px solid var(--hairline);
        padding-bottom: 2px;
        transition: border-color 500ms var(--ease);
      }

      .foot__links a:hover {
        border-color: rgba(255, 255, 255, 0.4);
      }

      .foot__meta {
        margin-top: 1.75rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        color: var(--muted);
      }

      .reveal {
        opacity: 0;
        filter: blur(8px);
        transform: translateY(1.75rem);
        transition:
          opacity 900ms var(--ease),
          transform 900ms var(--ease),
          filter 900ms var(--ease);
        transition-delay: calc(var(--index, 0) * 90ms);
      }

      .reveal.is-visible {
        opacity: 1;
        filter: none;
        transform: none;
      }

      @media (min-width: 900px) {
        .island__alt {
          display: inline-flex;
        }
        .burger {
          display: none;
        }
      }

      @media (max-width: 899px) {
        .island__nav {
          display: none;
        }
        .burger {
          display: grid;
        }
        .bento {
          grid-template-columns: 1fr;
        }
        .bezel--hero,
        .bezel--md,
        .bezel--wide {
          grid-column: span 1;
          grid-row: auto;
        }
        .bezel--hero .tile {
          min-height: 220px;
        }
        .posts {
          grid-template-columns: 1fr;
        }
        .foot__inner {
          grid-template-columns: 1fr;
        }
        .hero {
          align-items: center;
          padding-top: 6rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
        .reveal {
          opacity: 1;
          filter: none;
          transform: none;
        }
        .overlay__link {
          opacity: 1;
          transform: none;
          animation: none;
        }
      }
    </style>
  </body>
</html>
